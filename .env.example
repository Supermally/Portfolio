# Password used at /admin. Use a long, unique value.
ADMIN_PASSWORD=

# Random secret used to sign the 12-hour admin session cookie.
ADMIN_SESSION_SECRET=

# Fine-grained GitHub token with Contents: Read and write access to Supermally/Portfolio only.
GITHUB_CONTENT_TOKEN=
GITHUB_CONTENT_REPO=Supermally/Portfolio
GITHUB_CONTENT_BRANCH=main
